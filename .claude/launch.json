{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sound-check",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8765
    },
    {
      "name": "pad",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "@raceball/pad",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "@raceball/web",
        "dev"
      ],
      "port": 5173
    }
  ]
}
